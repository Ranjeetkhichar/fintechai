# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# Postgres (Neon or local). SSL is configured in code, so sslmode and
# channel_binding in the string are ignored; leaving them in is harmless.
DB_CONNECTION_STRING=postgresql://user:password@host/dbname

# Optional connection tuning
# DB_CONNECT_TIMEOUT_MS=30000
# DB_POOL_MAX=5
# How long an unused connection is kept. Long by default so questions reuse a
# warm socket instead of paying a fresh handshake. 0 keeps them forever.
# DB_IDLE_TIMEOUT_MS=300000
# Debug only, for a TLS-intercepting proxy. Never leave this on.
# DB_SSL_INSECURE=true

# Fixed clock. Every date phrase ("last month", "this quarter", "YTD") resolves
# against this date, so gold answers in docs/EXAMPLES.md stay reproducible.
CHEESE_AS_OF=2026-09-05

# Model used by the NLU + verbalizer. Cloud providers go through LLM_BASE_URL.
# Ollama stays local so the settings dropdown can list installed models.
AI_SERVICE=ollama
AI_MODEL=qwen3.8:27b
LLM_BASE_URL=https://inference.coralbricks.ai/v1
LLM_TIMEOUT=180000
OLLAMA_BASE_URL=http://localhost:11434
# CORAL_API_KEY=

PORT=3000
